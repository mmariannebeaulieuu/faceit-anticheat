[Version]
Signature="$WINDOWS NT$"
Class=Security
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
DriverVer=10/25/2024,1.0.0.0
CatalogFile=AntiCheatKernelDriver.cat

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=Install,Root\AcKernelMonitor

[DestinationDirs]
DriverCopy=12

[Install]
CopyFiles=DriverCopy

[DriverCopy]
AntiCheatKernelDriver.sys

[Install.Services]
AddService=AcKernelMonitor,0,ServiceInstall

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\AntiCheatKernelDriver.sys

[Strings]
ManufacturerName="Educational AntiCheat"
DeviceDesc="AntiCheat Kernel Monitor"
ServiceName="AcKernelMonitor"
